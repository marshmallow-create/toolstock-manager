{
  "name": "toolstock-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:db": "node scripts/run-typescript.mjs test",
    "auth:setup-dev": "node scripts/run-typescript.mjs setup",
    "test:auth": "node scripts/run-typescript.mjs auth",
    "test:http": "node scripts/run-typescript.mjs http",
    "test": "npm run test:permissions && npm run test:roles-migration && npm run test:cleanup-migration && npm run test:db && npm run test:auth && npm run test:masters && npm run test:inventory && npm run test:tool-import && npm run build && npm run test:http && npm run test:masters-http && npm run test:inventory-http && npm run test:tool-import-http",
    "test:cleanup-migration": "node --test tests/backup-target.test.mjs && node scripts/run-typescript.mjs cleanup-migration",
    "db:backup": "node scripts/backup-database.mjs",
    "test:tool-import": "node scripts/run-typescript.mjs tool-workbook && node scripts/run-typescript.mjs tool-import",
    "test:tool-import-http": "node scripts/run-typescript.mjs tool-import-http",
    "test:masters": "node scripts/run-typescript.mjs masters",
    "test:masters-http": "node scripts/run-typescript.mjs masters-http",
    "test:inventory": "node scripts/run-typescript.mjs inventory",
    "test:inventory-http": "node scripts/run-typescript.mjs inventory-http",
    "test:permissions": "node scripts/run-typescript.mjs permissions",
    "test:roles-migration": "node scripts/run-typescript.mjs roles-migration"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "dotenv": "17.2.3",
    "exceljs": "4.4.0",
    "next": "16.1.6",
    "pg": "8.17.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "saxes": "6.0.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.7",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "2.10.3",
    "esbuild": "0.27.7",
    "jszip": "3.10.1",
    "prisma": "7.3.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
